[sub_resource type="GDScript" id="GDScript_5v8c0"]
script/source = "extends Area3D

@export var interaction_text: Label3D
var player_in_range = false
signal interacted  # Define the signal

func _ready():
	interaction_text.visible = false  # Caché au départ
	connect(\"body_entered\", _on_body_entered)
	connect(\"body_exited\", _on_body_exited)

func _on_body_entered(body):
	if body.is_in_group(\"player\"):  # Assure-toi que le joueur est dans ce groupe
		player_in_range = true
		interaction_text.visible = true

func _on_body_exited(body):
	if body.is_in_group(\"player\"):
		player_in_range = false
		interaction_text.visible = false

func _input(event):
	if player_in_range and event.is_action_pressed(\"use_action\"):  # \"ui_accept\" correspond généralement à E
		interact()

func interact():
	print(\"Interaction déclenchée !\")  # Remplace par ton action (ouvrir une porte, ramasser un objet, etc.)
	interacted.emit()  # Emit the signal when interacting
"

